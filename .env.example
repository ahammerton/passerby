# Copy to .env and edit. Location, units, radii, train options and logins can
# also be changed from the settings page (⚙); those changes are saved in
# data/settings.json and take priority over the values here.

# --- Home location (decimal degrees) -----------------------------------------
# The default is Heathrow Airport: change it to where you live.
HOME_LAT=51.4700
HOME_LON=-0.4543
HOME_NAME=Home

# Aircraft further than this are ignored (km). Keep under ~250 so the OpenSky
# bounding box stays in the cheapest 1-credit-per-call band.
RADIUS_KM=150
# "Overhead" alert radius (km) and the minimum altitude that counts (ft).
ALERT_RADIUS_KM=10
ALERT_MIN_ALTITUDE_FT=300

# --- OpenSky Network ---------------------------------------------------------
# Create a free account at https://opensky-network.org, then create an API
# client on your account page. Without credentials the app polls every 4 min.
OPENSKY_ENABLED=true
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Seconds between polls; 0 = automatic (30s with credentials, 240s without).
OPENSKY_INTERVAL=0

# --- Community ADS-B networks ----------------------------------------------
# Unfiltered (military included), updated every few seconds.
ADSBLOL_ENABLED=true
# Seconds between polls. adsb.lol rate-limits per internet connection, so keep this
# at 30 or more, and run only one copy of the app per connection.
ADSBLOL_INTERVAL=30
# airplanes.live asks you to email contact@airplanes.live describing your
# project before using their API. Enable only once they've said yes.
AIRPLANESLIVE_ENABLED=false
AIRPLANESLIVE_INTERVAL=10

# --- Aircraft details, routes and photos -------------------------------------
# Registration, type, operator and route from adsbdb.com (cached in data/).
ENRICHMENT_ENABLED=true
# Seconds between adsbdb lookups.
ENRICHMENT_DELAY=1
# Photos from planespotters.net. Their API requires a contact URL or email in
# requests, so photos stay off until CONTACT is set.
PHOTOS_ENABLED=true
CONTACT=

# --- Buses (Bus Open Data Service, England) ---------------------------------
# Free API key: https://data.bus-data.dft.gov.uk. Buses stay off until it's set.
BODS_API_KEY=
BUSES_ENABLED=true
# Buses within this distance of home (km) are fetched...
BUS_RADIUS_KM=10
# ...and shown only when the map is zoomed in at least this far (12 is a town and its surroundings).
BUS_MIN_ZOOM=12
# Seconds between polls (BODS refreshes about every 10 s).
BUS_INTERVAL=15
# Delays and next stops from BODS's timetables: a ~300 MB weekly download, cut down to the
# trips near home. BUS_REGION is a BODS region (south_east, london, ...) or auto.
BUS_DELAYS=true
BUS_REGION=auto
# Diversions, stop closures and road closures affecting buses (BODS, same key).
BUS_DISRUPTIONS=true

# --- Roads: closures and incidents on motorways and major A-roads (National Highways) ---
# Free key: register at https://developer.data.nationalhighways.co.uk and subscribe to
# "Road & Lane Closures". Roads stay off until it's set.
NATIONAL_HIGHWAYS_API_KEY=
ROADS_ENABLED=true
ROAD_RADIUS_KM=15

# --- UK trains (Network Rail open data) ---------------------------------------
# Free account: https://publicdatafeeds.networkrail.co.uk/ntrod/create-account
# Trains stay off until both are set.
NROD_USERNAME=
NROD_PASSWORD=
# Every train within this radius of home is shown on the map.
TRAIN_RADIUS_KM=5
# "Trains past home": the two adjacent stations either side of you, e.g. FEL,AFS
TRAIN_WATCH=
# Alert this many seconds before a train is estimated to pass home.
TRAIN_ALERT_SECONDS=60
# "Passing home" on the Now tab, and how many minutes ahead it looks.
PASSING_WINDOW=true
PASSING_MINUTES=5
# Departure boards for these station codes (comma separated). Empty = nearest station.
TRAIN_BOARDS=

# --- Your own ADS-B receiver (optional) --------------------------------------
# Any receiver serving aircraft.json: readsb/tar1090, dump1090-fa, or the dump1090 in a
# Flightradar24 / FlightAware feeder (e.g. http://192.168.1.50/dump1090/data/aircraft.json).
# The settings page can find this URL from just the receiver's IP address.
READSB_ENABLED=false
# Existing readsb/tar1090 on another machine:
#   READSB_URL=http://raspberrypi.local/tar1090/data/aircraft.json
# Ultrafeeder from docker-compose (--profile receiver):
#   READSB_URL=http://ultrafeeder/data/aircraft.json
READSB_URL=http://ultrafeeder/data/aircraft.json
# With a receiver: "fill" = online feeds add aircraft beyond its range (your receiver wins for
# any aircraft both see); "backup" = online feeds only run while the receiver isn't answering.
ONLINE_FEEDS=fill
RECEIVER_ALT_M=50
TZ=Europe/London

# --- Security -----------------------------------------------------------------
# Password for the settings page. Strongly recommended: without it, anyone who can
# reach the app can change its settings and logins. The map stays open either way.
ADMIN_PASSWORD=
# Host names the app is reached by, if not an IP address, localhost, or a local name
# (.local, .lan, .home.arpa, .internal, .ts.net). Comma separated; "*" allows any.
# Requests naming any other host are refused (this blocks DNS-rebinding attacks).
ALLOWED_HOSTS=

# --- HTTPS via Caddy (optional, --profile https) -----------------------------
SITE_ADDRESS=flights.home.arpa
# With Caddy in front, publish plain HTTP on this machine only, so it can't bypass HTTPS.
# APP_BIND=127.0.0.1
